<UserControl x:Class="HyperVToolsX.App.Views.TargetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HyperVToolsX.App.Converters"
             MinWidth="900"
             MinHeight="520">

    <UserControl.Resources>
        <conv:BoolToGlyphConverter x:Key="BoolToGlyphConverter"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Right-aligned columns for boolean/glyph cells -->
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">
            <TextBlock Text="Target Manager"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="Manage Hyper-V hosts, clusters, and connection settings."
                       Foreground="#666666"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    x:Name="TargetManagerTabControl">
            <TabItem Header="Hosts / Clusters">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Input area -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="120"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Hosts / Clusters — one per line (hostname, FQDN, or IP)"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBox x:Name="TargetInputTextBox"
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Padding="6"
                                         FontFamily="Consolas"
                                         KeyDown="TargetInputTextBox_KeyDown"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="ImportButton"
                                    Content="Import TXT"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Import a text file with one host/cluster per line"
                                    Click="ImportButton_Click"/>

                            <Button x:Name="AddTargetsButton"
                                    Content="Add Targets"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Add the entries above (Ctrl+Enter)"
                                    Click="AddTargetsButton_Click"/>

                            <Button x:Name="RemoveSelectedButton"
                                    Content="Remove Selected"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Remove the highlighted target(s) from the list"
                                    Click="RemoveSelectedButton_Click"/>

                            <Button x:Name="ClearButton"
                                    Content="Clear All"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Margin="0"
                                    Click="ClearButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Target grid -->
                    <Border Grid.Row="1"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F5F5F5"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TargetCountText"
                                                   Text="0 targets"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="ReadyCountText"
                                                   Text=""
                                                   Foreground="#1E8E3E"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="FailedCountText"
                                                   Text=""
                                                   Foreground="#C42B2B"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="Workers:"
                                               Margin="20,0,5,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="WorkerCountText"
                                               Grid.Column="2"
                                               Text="1"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="FilterTextBox"
                                             Grid.Column="3"
                                             Margin="15,0,0,0"
                                             Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             Tag="Filter targets..."
                                             TextChanged="FilterTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="TargetDataGrid"
  Grid.Row="1"
  AutoGenerateColumns="False"
  IsReadOnly="True"
  CanUserSortColumns="True"
  CanUserResizeColumns="True"
  CanUserReorderColumns="True"
  SelectionMode="Extended"
  SelectionUnit="FullRow"
  EnableRowVirtualization="True"
  EnableColumnVirtualization="True"
  ScrollViewer.HorizontalScrollBarVisibility="Auto"
  ScrollViewer.VerticalScrollBarVisibility="Auto"
  ScrollViewer.CanContentScroll="False"
  VirtualizingPanel.IsVirtualizing="True"
  VirtualizingPanel.VirtualizationMode="Recycling"
  MinRowHeight="28">

                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Disconnect Selected"
                      Click="DisconnectSelectedMenuItem_Click"/>
                                        <MenuItem Header="Remove Selected"
                      Click="RemoveSelectedButton_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Copy Name(s)"
                      Click="CopyNamesMenuItem_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Target"
                            Binding="{Binding Name}"
                            SortMemberPath="Name"
                            Width="2*"
                            MinWidth="180"/>

                                    <DataGridTextColumn Header="Type"
                            Binding="{Binding Type}"
                            SortMemberPath="Type"
                            Width="90"
                            MinWidth="80"/>

                                    <DataGridTemplateColumn Header="DNS"
                                SortMemberPath="NameResolved"
                                Width="60"
                                MinWidth="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CenteredCellStyle}"
                               Text="{Binding NameResolved, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                               Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Ping"
                                SortMemberPath="PingSucceeded"
                                Width="60"
                                MinWidth="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CenteredCellStyle}"
                               Text="{Binding PingSucceeded, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                               Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Hyper-V"
                                SortMemberPath="HyperVConnectionSucceeded"
                                Width="70"
                                MinWidth="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CenteredCellStyle}"
                               Text="{Binding HyperVConnectionSucceeded, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                               Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Result"
                                SortMemberPath="Result"
                                Width="2*"
                                MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Error"
                            Binding="{Binding ErrorMessage}"
                            SortMemberPath="ErrorMessage"
                            Width="3*"
                            MinWidth="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="0,4"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Progress -->
                    <Grid Grid.Row="2"
                          Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="OperationProgressBar"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="1"
                                     Visibility="Collapsed"/>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Foreground="#666666"/>
                    </Grid>

                    <!-- Action bar -->
                    <DockPanel Grid.Row="3"
                               Margin="0,15,0,0">
                        <!-- Action bar -->
                        <Grid Grid.Row="3"
      Margin="0,15,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left -->
                            <Button x:Name="CancelButton"
            Grid.Column="0"
            Content="Cancel"
            Width="120"
            Height="35"
            HorizontalAlignment="Left"
            IsEnabled="False"
            Click="CancelButton_Click"/>

                            <!-- Right -->
                            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                                <Button x:Name="ValidateButton"
                Content="Validate"
                Width="120"
                Height="35"
                Margin="0,0,8,0"
                IsEnabled="True"
                Click="ValidateButton_Click"/>

                                <Button x:Name="CollectButton"
                Content="Start Collection"
                Width="140"
                Height="35"
                Margin="0,0,8,0"
                IsEnabled="False"
                Click="CollectButton_Click"/>

                                <Button x:Name="GoToMainButton"
                Content="Go to Main"
                Width="120"
                Height="35"
                IsEnabled="False"
                Click="GoToMainButton_Click"/>

                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Connection Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,12,0,0">
                    <Grid MaxWidth="700"
                          HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Authentication"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="UseCurrentWindowsCredentialsCheckBox"
                                  Grid.Row="1"
                                  Content="Use current Windows credentials"
                                  IsChecked="True"
                                  Margin="0,0,0,15"
                                  Checked="UseCurrentWindowsCredentialsCheckBox_Changed"
                                  Unchecked="UseCurrentWindowsCredentialsCheckBox_Changed"/>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Username:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="UsernameTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,8"
                                     IsEnabled="False"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Password:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <PasswordBox x:Name="PasswordBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="28"
                                         Margin="0,0,0,8"
                                         IsEnabled="False"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Authentication:"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="AuthenticationComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Height="28"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Default"/>
                                <ComboBoxItem Content="Negotiate"/>
                                <ComboBoxItem Content="Kerberos"/>
                                <ComboBoxItem Content="Basic"/>
                                <ComboBoxItem Content="CredSSP"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="Connection"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5,0,12"/>

                        <Grid Grid.Row="4"
                              Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="UseSslCheckBox"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Content="Use SSL/TLS (HTTPS - port 5986)"
                                      Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Port (0 = auto):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="PortTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Text="0"
                                     Height="28"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Timeout (seconds):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="TimeoutTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Text="30"
                                     Height="28"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Max concurrent workers:"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="MaxWorkersTextBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Text="0"
                                     Height="28"
                                     ToolTip="0 = auto-calculate based on target count"/>
                        </Grid>

                        <TextBlock Grid.Row="5"
                                   Text="SSL Options (for self-signed certificates)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5,0,12"/>

                        <StackPanel Grid.Row="5"
                                    Margin="0,35,0,0">
                            <CheckBox x:Name="SkipCaCertificateCheckBox"
                                      Content="Skip CA certificate check"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="SkipCnHostnameCheckBox"
                                      Content="Skip CN (hostname) check"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
