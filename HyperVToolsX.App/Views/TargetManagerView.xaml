<UserControl x:Class="HyperVToolsX.App.Views.TargetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HyperVToolsX.App.Converters"
             xmlns:controls="clr-namespace:HyperVToolsX.App.Controls"
             MinWidth="675"
             MinHeight="450"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <conv:BoolToGlyphConverter x:Key="BoolToGlyphConverter"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

        <Style x:Key="SideButtonText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Centered glyph cells (DNS / Ping / Hyper-V) -->
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="19.5,13.5,19.5,16.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="53"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="3,0,3,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="13.5,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Target Manager" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Manage Hyper-V hosts, clusters, and connection settings."
                               Style="{StaticResource MutedText}"
                               FontSize="11"
                               Margin="0,1.5,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.FileText}" Width="13.5" Height="13.5" Foreground="#5A6B85"/>
                <TextBlock Text="Add and manage your targets to collect inventory data."
                           Style="{StaticResource MutedText}"
                           Margin="7.5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- TABS -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl x:Name="TargetManagerTabControl" Padding="16.5,15,16.5,15" >

                <!-- Hosts / Clusters -->
                <TabItem MinWidth="195">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource Icon.Servers}" Width="15" Height="15"/>
                            <TextBlock Text="Hosts / Clusters" Margin="7.5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="123*" MinHeight="150"/>
                            <RowDefinition Height="118*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input card -->
                        <Border
                                Style="{StaticResource Card}"
                                Padding="15" Height="223" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10.5">
                                        <Border Style="{StaticResource IconTile}" Width="39" Height="39" Background="#E8F0FE">
                                            <controls:Icon Data="{StaticResource Icon.Servers}" Width="19.5" Height="19.5" Foreground="{StaticResource BlueBrush}"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hosts / Clusters" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Enter one host, cluster, FQDN, or IP address per line."
                                                       Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Row="1" MinHeight="54" Margin="0,0,0,20">
                                        <TextBox x:Name="TargetInputTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Padding="12,10.5"
                                                 KeyDown="TargetInputTextBox_KeyDown"/>

                                        <TextBlock Text="e.g. hyperv01, cluster01.domain.local or 192.168.1.10"
                                                   Margin="13.5,12,0,0"
                                                   Foreground="#9AA6B8"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TargetInputTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="16.5,0,0,0" Width="172.5" VerticalAlignment="Top">
                                    <Button x:Name="ImportButton"
                                            Style="{StaticResource TintButton}"
                                            Height="37.5"
                                            HorizontalContentAlignment="Left"
                                            Padding="18,0"
                                            Margin="0,0,0,7.5"
                                            ToolTip="Import a text file with one host/cluster per line"
                                            Click="ImportButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Data="{StaticResource Icon.File}" Width="15" Height="15"/>
                                            <TextBlock Text="Import TXT" Style="{StaticResource SideButtonText}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="AddTargetsButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="37.5"
                                            HorizontalContentAlignment="Left"
                                            Padding="18,0"
                                            Margin="0,0,0,7.5"
                                            ToolTip="Add the entries above (Ctrl+Enter)"
                                            Click="AddTargetsButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
                                            <TextBlock Text="Add Targets" Style="{StaticResource SideButtonText}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="RemoveSelectedButton"
                                            Height="37.5"
                                            HorizontalContentAlignment="Left"
                                            Padding="18,0"
                                            Margin="0,0,0,7.5"
                                            ToolTip="Remove the highlighted target(s) from the list"
                                            Click="RemoveSelectedButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Data="{StaticResource Icon.Trash}" Width="15" Height="15"/>
                                            <TextBlock Text="Remove Selected" Style="{StaticResource SideButtonText}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="ClearButton"
                                            Height="37.5"
                                            HorizontalContentAlignment="Left"
                                            Padding="18,0"
                                            Click="ClearButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Data="{StaticResource Icon.Brush}" Width="15" Height="15"/>
                                            <TextBlock Text="Clear All" Style="{StaticResource SideButtonText}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Targets card -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15,13.5,15,15" Margin="0,10,0,28" Grid.RowSpan="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconTile}" Width="39" Height="39" Background="#E8F0FE">
                                            <controls:Icon Data="{StaticResource Icon.List}" Width="19.5" Height="19.5" Foreground="{StaticResource BlueBrush}"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Targets" Style="{StaticResource SectionTitle}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="List of configured targets and their status."
                                                           Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="TargetCountText"
                                                           Text="0 targets"
                                                           Style="{StaticResource MutedText}"
                                                           FontWeight="SemiBold"
                                                           Margin="10.5,0,0,0"/>
                                                <TextBlock x:Name="ReadyCountText"
                                                           Text=""
                                                           Foreground="{StaticResource GreenBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="7.5,0,0,0"/>
                                                <TextBlock x:Name="FailedCountText"
                                                           Text=""
                                                           Foreground="{StaticResource RedBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="7.5,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7.5" Height="7.5"
                                                 Fill="{StaticResource GreenBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,7.5,0"/>
                                        <TextBlock x:Name="WorkerCountText"
                                                   Text="Workers: 0 active / 1"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        Background="White">
                                    <Grid>
                                        <DataGrid x:Name="TargetDataGrid"
                                                  BorderThickness="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserSortColumns="False"
                                                  CanUserResizeColumns="True"
                                                  CanUserReorderColumns="True"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="False"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  SelectionChanged="TargetDataGrid_SelectionChanged">

                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Remove Selected"
                                                              Click="RemoveSelectedButton_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Copy Name(s)"
                                                              Click="CopyNamesMenuItem_Click"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>

                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserReorder="False">
                                                    <DataGridTemplateColumn.Header>
                                                        <CheckBox x:Name="SelectAllCheckBox"
                                                                  Margin="3,0,0,0"
                                                                  ToolTip="Select all targets"
                                                                  Click="SelectAllCheckBox_Click"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="3,0,0,0"
                                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Target"
                                                                    Binding="{Binding Name}"
                                                                    SortMemberPath="Name"
                                                                    Width="2*"
                                                                    MinWidth="135"/>

                                                <DataGridTextColumn Header="Type"
                                                                    Binding="{Binding TypeDisplay}"
                                                                    SortMemberPath="Type"
                                                                    Width="97.5"
                                                                    MinWidth="75"/>

                                                <DataGridTextColumn Header="Cluster"
                                                                    Binding="{Binding ClusterName}"
                                                                    SortMemberPath="ClusterName"
                                                                    Width="*"
                                                                    MinWidth="90"/>

                                                <DataGridTemplateColumn Header="DNS"
                                                                        SortMemberPath="NameResolved"
                                                                        Width="60"
                                                                        MinWidth="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource CenteredCellStyle}"
                                                                       Text="{Binding NameResolved, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                                                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Ping"
                                                                        SortMemberPath="PingSucceeded"
                                                                        Width="60"
                                                                        MinWidth="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource CenteredCellStyle}"
                                                                       Text="{Binding PingSucceeded, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                                                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Hyper-V"
                                                                        SortMemberPath="HyperVConnectionSucceeded"
                                                                        Width="75"
                                                                        MinWidth="65">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource CenteredCellStyle}"
                                                                       Text="{Binding HyperVConnectionSucceeded, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter=Blank}"
                                                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Result"
                                                                        SortMemberPath="Result"
                                                                        Width="2*"
                                                                        MinWidth="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Result}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Error"
                                                                    Binding="{Binding ErrorMessage}"
                                                                    SortMemberPath="ErrorMessage"
                                                                    Width="3*"
                                                                    MinWidth="135">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="Padding" Value="0,4"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Empty state, shown while no targets are listed -->
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=TargetDataGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <controls:Icon Data="{StaticResource Icon.ServerStack}"
                                                           Width="40" Height="40"
                                                           StrokeThickness="1.2"
                                                           Foreground="#B9C6DC"
                                                           HorizontalAlignment="Center" Margin="0,0,20,0"/>
                                            <TextBlock Text="No targets added yet"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Progress -->
                        <Grid Grid.Row="2" Margin="2,9,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ProgressBar x:Name="OperationProgressBar"
                                         Height="4.5"
                                         Minimum="0"
                                         Maximum="1"
                                         Visibility="Collapsed"/>

                            <Grid Grid.Row="1" Margin="0,4.5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="StatusText"
                                           Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="ElapsedText"
                                           Grid.Column="1"
                                           Margin="9,0,0,0"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BlueBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Connection Settings -->
                <TabItem MinWidth="195">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource Icon.Settings}" Width="15" Height="15"/>
                            <TextBlock Text="Connection Settings" Margin="7.5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,9,0">

                            <!-- Authentication -->
                            <Border Style="{StaticResource Card}" Padding="16.5,13.5" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Authentication" Style="{StaticResource SectionTitle}" Margin="0,0,0,10.5"/>

                                    <CheckBox x:Name="UseCurrentWindowsCredentialsCheckBox"
                                              Content="Use current Windows credentials"
                                              IsChecked="True"
                                              Margin="0,0,0,12"
                                              Checked="UseCurrentWindowsCredentialsCheckBox_Changed"
                                              Unchecked="UseCurrentWindowsCredentialsCheckBox_Changed"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112.5"/>
                                            <ColumnDefinition Width="255"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,7.5,7.5"/>
                                        <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,7.5" IsEnabled="False"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,7.5,7.5"/>
                                        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,7.5" IsEnabled="False"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Authentication:" VerticalAlignment="Center" Margin="0,0,7.5,0"/>
                                        <ComboBox x:Name="AuthenticationComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0">
                                            <ComboBoxItem Content="Default"/>
                                            <ComboBoxItem Content="Negotiate"/>
                                            <ComboBoxItem Content="Kerberos"/>
                                            <ComboBoxItem Content="Basic"/>
                                            <ComboBoxItem Content="CredSSP"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Connection -->
                            <Border Style="{StaticResource Card}" Padding="16.5,13.5" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" Margin="0,0,0,10.5"/>

                                    <CheckBox x:Name="UseSslCheckBox"
                                              Content="Use SSL/TLS (HTTPS - port 5986)"
                                              Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112.5"/>
                                            <ColumnDefinition Width="255"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Port (0 = auto):" VerticalAlignment="Center" Margin="0,0,7.5,7.5"/>
                                        <TextBox x:Name="PortTextBox" Grid.Row="0" Grid.Column="1" Text="0" Margin="0,0,0,7.5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Timeout (seconds):" VerticalAlignment="Center" Margin="0,0,7.5,0"/>
                                        <TextBox x:Name="TimeoutTextBox" Grid.Row="1" Grid.Column="1" Text="30"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SSL options -->
                            <Border Style="{StaticResource Card}" Padding="16.5,13.5">
                                <StackPanel>
                                    <TextBlock Text="SSL Options" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="For self-signed certificates." Style="{StaticResource MutedText}" Margin="0,1.5,0,10.5"/>

                                    <CheckBox x:Name="SkipCaCertificateCheckBox"
                                              Content="Skip CA certificate check"
                                              Margin="0,0,0,9"/>

                                    <CheckBox x:Name="SkipCnHostnameCheckBox"
                                              Content="Skip CN (hostname) check"/>

                                    <TextBlock Text="Skipping these checks weakens TLS: the host's identity is not fully verified."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7.5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- TrustedHosts -->
                            <Border Style="{StaticResource Card}" Padding="16.5,13.5" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="TrustedHosts" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Only needed for bare-IP targets over HTTP (no SSL) that have no DNS name."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,1.5,0,10.5"/>

                                    <CheckBox x:Name="AllowTrustedHostsCheckBox"
                                              Content="Allow adding the target IP to this machine's WinRM TrustedHosts (persistent)"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Live Log -->
                <TabItem MinWidth="195">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource Icon.FileText}" Width="15" Height="15"/>
                            <TextBlock Text="Live Log" Margin="7.5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Copy" Width="63" MinHeight="25.5" Margin="0,0,6,0" Click="LogCopyButton_Click"/>
                                <Button Content="Save..." Width="63" MinHeight="25.5" Margin="0,0,6,0" Click="LogSaveButton_Click"/>
                                <Button Content="Clear" Width="63" MinHeight="25.5" Click="LogClearButton_Click"/>
                            </StackPanel>

                            <CheckBox x:Name="LogAutoScrollCheckBox"
                                      Content="Auto-scroll"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="0,0,13.5,0"/>

                            <TextBlock x:Name="LogCountText"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Background="White">
                            <DataGrid x:Name="LogDataGrid"
                                      BorderThickness="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      FontFamily="Consolas"
                                      FontSize="11"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="MinHeight" Value="26"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="#C42B2B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="#B26A00"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Step">
                                                <Setter Property="Foreground" Value="#1F4E8C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time"
                                                        Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                                        Width="82.5"/>
                                    <DataGridTextColumn Header="Level"
                                                        Binding="{Binding Level}"
                                                        Width="60"/>
                                    <DataGridTextColumn Header="Source"
                                                        Binding="{Binding Source}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Target"
                                                        Binding="{Binding Target}"
                                                        Width="135"/>
                                    <DataGridTextColumn Header="Message"
                                                        Binding="{Binding Message}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ACTION BAR -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Style="{StaticResource SoftButton}"
                    Width="139.5"
                    Height="39"
                    HorizontalAlignment="Left"
                    Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource Icon.Close}" Width="13.5" Height="13.5"/>
                    <TextBlock Text="Cancel" Style="{StaticResource SideButtonText}"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ValidateButton"
                        Style="{StaticResource SoftButton}"
                        Width="150"
                        Height="39"
                        Margin="0,0,10.5,0"
                        IsEnabled="True"
                        Click="ValidateButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Icon.Shield}" Width="15" Height="15"/>
                        <TextBlock Text="Validate" Style="{StaticResource SideButtonText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CollectButton"
                        Style="{StaticResource PrimaryButton}"
                        Width="169.5"
                        Height="39"
                        IsEnabled="False"
                        Click="CollectButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Icon.Play}" Width="13.5" Height="13.5"/>
                        <TextBlock Text="Start Collection" Style="{StaticResource SideButtonText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
