<Window x:Class="HyperVToolsX.App.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Tab"
        Icon="/Resources/logo.png"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F2F2F2">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name and row source -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Tab name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameTextBox" Grid.Column="1" MaxLength="31" Padding="4" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="2" Text="Rows:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="RowSourceComboBox" Grid.Column="3" Padding="4"
                      DisplayMemberPath="Display"
                      SelectionChanged="RowSourceComboBox_SelectionChanged"/>
        </Grid>

        <!-- Field pickers -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Available -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Available fields" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceFilterComboBox" Padding="4" Margin="0,0,4,0"
                              ToolTip="Show fields from one tab only"
                              SelectionChanged="SourceFilterComboBox_SelectionChanged"/>
                    <TextBox x:Name="FilterTextBox" Grid.Column="1" Padding="4"
                             ToolTip="Filter available fields"
                             TextChanged="FilterTextBox_TextChanged"/>
                </Grid>
                <ListBox x:Name="AvailableListBox"
                         SelectionMode="Extended"
                         DisplayMemberPath="Display"
                         MouseDoubleClick="AvailableListBox_MouseDoubleClick"/>
            </DockPanel>

            <!-- Add / remove -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="Add &#x2192;" Padding="8,4" Margin="0,0,0,6" Click="AddButton_Click"/>
                <Button Content="&#x2190; Remove" Padding="8,4" Click="RemoveButton_Click"/>
            </StackPanel>

            <!-- Selected -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Columns in this tab (in order)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="Column header:" Margin="0,0,0,2"/>
                    <TextBox x:Name="HeaderTextBox" Padding="4" IsEnabled="False"
                             TextChanged="HeaderTextBox_TextChanged"/>
                </StackPanel>
                <ListBox x:Name="SelectedListBox"
                         SelectionMode="Extended"
                         DisplayMemberPath="Display"
                         SelectionChanged="SelectedListBox_SelectionChanged"
                         MouseDoubleClick="SelectedListBox_MouseDoubleClick"/>
            </DockPanel>

            <!-- Reorder -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="Up &#x2191;" Padding="8,4" Margin="0,0,0,6" Click="MoveUpButton_Click"/>
                <Button Content="Down &#x2193;" Padding="8,4" Click="MoveDownButton_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HintText" Grid.Row="2" Foreground="#555555" Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#C42B1C" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Padding="6,4" IsDefault="True" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="90" Padding="6,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
