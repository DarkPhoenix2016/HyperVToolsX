<Window x:Class="HyperVToolsX.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About HyperVToolsX"
        Icon="/Resources/logo.png"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F2F2F2">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER / LOGO -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Height="115">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Application Logo -->
            <Border Grid.Column="0"
                    Width="100"
                    Height="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="4">

                <Image Source="/Views/logo.png"
       Stretch="Uniform"
       Margin="5"/>
            </Border>

            <!-- Application Name -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0">

                <TextBlock Text="HyperVToolsX"
                           FontSize="16"
                           FontWeight="Light"
                           Foreground="#0078D4"/>

                <TextBlock Text="Hyper-V Inventory &amp; Management Tool"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,4,0,0"/>

                <TextBlock Text="BETA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#666666"
                           Margin="0,8,0,0"/>

            </StackPanel>

        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1"
                Background="#BFBFBF"/>

        <!-- ========================================================= -->
        <!-- INFORMATION -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2"
              Margin="38,18,20,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Product -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Product:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="HyperVToolsX"
                       Margin="0,0,0,8"/>

            <!-- Version -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Version:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="VersionText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="0.1.0-beta.1"
                       Margin="0,0,0,8"/>

            <!-- Publisher -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Publisher:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="Charitha Piyumal"
                       Margin="0,0,0,8"/>

            <!-- Copyright -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Copyright:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       Text="© 2026 Charitha Piyumal"
                       Margin="0,0,0,8"/>

            <!-- GitHub -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Project:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Text="GitHub — HyperVToolsX"
                       Foreground="#0067B8"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       Margin="0,0,0,8"
                       MouseLeftButtonUp="GitHubTextBlock_MouseLeftButtonUp"/>

            <!-- Releases -->
            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Releases:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="5"
                       Grid.Column="1"
                       Text="Releases &amp; Downloads"
                       Foreground="#0067B8"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       Margin="0,0,0,8"
                       MouseLeftButtonUp="ReleasesTextBlock_MouseLeftButtonUp"/>

            <!-- Issues -->
            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="Support:"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Row="6"
                       Grid.Column="1"
                       Text="Report a Problem"
                       Foreground="#0067B8"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       MouseLeftButtonUp="IssuesTextBlock_MouseLeftButtonUp"/>

        </Grid>

        <!-- ========================================================= -->
        <!-- BUTTON BAR -->
        <!-- ========================================================= -->

        <Grid Grid.Row="3"
              Margin="0,5,0,0">

            <Button Content="OK"
                    Width="75"
                    Height="27"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="OkButton_Click"/>

        </Grid>

    </Grid>

</Window>