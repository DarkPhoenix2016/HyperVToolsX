                                    Binding="{Binding AllowACountMCount}"
                                    SortMemberPath="AllowACountMCount"
                                    Width="140"/>

                        <DataGridTextColumn Header="CPU Brand"
                                    Binding="{Binding CpuBrandString}"
                                    SortMemberPath="CpuBrandString"
                                    Width="200"/>

                        <DataGridTextColumn Header="CPU Frequency Cap MHz"
                                    Binding="{Binding PerfCpuFreqCapMhz}"
                                    SortMemberPath="PerfCpuFreqCapMhz"
                                    Width="170"/>

                        <DataGridTextColumn Header="L3 Cache Ways"
                                    Binding="{Binding L3CacheWays}"
                                    SortMemberPath="L3CacheWays"
                                    Width="120"/>

                        <DataGridTextColumn Header="Physical Address Width"
                                    Binding="{Binding PhysicalAddressWidth}"
                                    SortMemberPath="PhysicalAddressWidth"
                                    Width="170"/>

