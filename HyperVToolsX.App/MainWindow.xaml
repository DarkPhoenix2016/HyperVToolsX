                                    Binding="{Binding Reserve}"
                                    SortMemberPath="Reserve"
                                    Width="100"/>

                        <DataGridTextColumn Header="Relative Weight"
                                    Binding="{Binding RelativeWeight}"
                                    SortMemberPath="RelativeWeight"
                                    Width="130"/>

                        <DataGridTextColumn Header="Max/NUMA Node"
                                    Binding="{Binding MaximumCountPerNumaNode}"
                                    SortMemberPath="MaximumCountPerNumaNode"
                                    Width="140"/>

                        <DataGridTextColumn Header="Max/NUMA Socket"
                                    Binding="{Binding MaximumCountPerNumaSocket}"
                                    SortMemberPath="MaximumCountPerNumaSocket"
                                    Width="150"/>

                        <DataGridTextColumn Header="Host Resource Protection"
                                    Binding="{Binding EnableHostResourceProtection}"
                                    SortMemberPath="EnableHostResourceProtection"
                                    Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="vMemory">
                <DataGrid x:Name="MemoryDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  RowHeight="28">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="VM Name"
                                    Binding="{Binding VmName}"
                                    SortMemberPath="VmName"
                                    Width="220"/>

                        <DataGridTextColumn Header="Host"
                                    Binding="{Binding HostName}"
                                    SortMemberPath="HostName"
                                    Width="180"/>

                        <DataGridTextColumn Header="Resource Pool"
                                    Binding="{Binding ResourcePoolName}"
                                    SortMemberPath="ResourcePoolName"
                                    Width="180"/>

                        <DataGridTextColumn Header="Buffer"
                                    Binding="{Binding Buffer}"
                                    SortMemberPath="Buffer"
                                    Width="80"/>

                        <DataGridTextColumn Header="Dynamic Memory"
                                    Binding="{Binding DynamicMemoryEnabled}"
                                    SortMemberPath="DynamicMemoryEnabled"
                                    Width="140"/>

                        <DataGridTextColumn Header="Maximum"
                                    Binding="{Binding Maximum}"
                                    SortMemberPath="Maximum"
                                    Width="150"/>

                        <DataGridTextColumn Header="Maximum/NUMA Node"
                                    Binding="{Binding MaximumPerNumaNode}"
