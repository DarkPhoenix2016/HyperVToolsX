                    Binding="{Binding VirtualHardDiskPath}" />

                            <DataGridTextColumn
                    Width="320"
                    Header="Virtual Machine Path"
                    Binding="{Binding VirtualMachinePath}" />

                            <DataGridTextColumn
                    Width="320"
