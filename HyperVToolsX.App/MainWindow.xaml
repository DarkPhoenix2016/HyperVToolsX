<Window x:Class="HyperVToolsX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HyperVToolsX.App.Converters"
        xmlns:controls="clr-namespace:HyperVToolsX.App.Controls"
        Title="HyperVToolsX"
        Icon="/Resources/logo.png"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>

        <!-- Header action buttons: icon + label -->
        <Style x:Key="HeaderButtonText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Connect..." Click="ConnectMenuItem_Click" InputGestureText="Ctrl+N"/>
                <Separator/>
                <MenuItem Header="Export to Excel..." Click="ExportToExcelMenuItem_Click" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="PreferencesMenuItem" Header="_Preferences">
                <MenuItem Header="Data Size Unit">
                    <Separator/>

                    <MenuItem
            x:Name="BytesUnitMenuItem"
            Header="Bytes"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="KbUnitMenuItem"
            Header="KB"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="MbUnitMenuItem"
            Header="MB"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="GbUnitMenuItem"
            Header="GB"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="TbUnitMenuItem"
            Header="TB"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="PbUnitMenuItem"
            Header="PB"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Refresh" Click="RefreshMenuItem_Click" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="New Custom Tab..." Click="NewCustomTabMenuItem_Click"/>
                <MenuItem Header="Manage Custom Tabs..." Click="ManageCustomTabsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About HyperVToolsX"
              Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- HEADER -->
        <Grid Grid.Row="1" Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Resources/logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HyperVToolsX"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FFC93C"
                                CornerRadius="6"
                                Margin="12,2,0,0"
                                Padding="9,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="BETA"
                                       Foreground="#4A3500"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Hyper-V Inventory &amp; Documentation Tool"
                               Style="{StaticResource MutedText}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshHeaderButton"
                        Height="48"
                        Padding="22,0"
                        Margin="0,0,12,0"
                        ToolTip="Reload the current inventory snapshot (F5)"
                        Click="RefreshMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Icon.Refresh}" Width="20" Height="20"/>
                        <TextBlock Text="Refresh" Style="{StaticResource HeaderButtonText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ExportHeaderButton"
                        Style="{StaticResource OutlineBlueButton}"
                        Height="48"
                        Padding="22,0"
                        Margin="0,0,12,0"
                        ToolTip="Export the current inventory to Excel (Ctrl+E)"
                        Click="ExportToExcelMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Icon.Download}" Width="20" Height="20"/>
                        <TextBlock Text="Export" Style="{StaticResource HeaderButtonText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ConnectHeaderButton"
                        Style="{StaticResource PrimaryButton}"
                        Height="48"
                        Padding="26,0"
                        Margin="0,0,12,0"
                        ToolTip="Add or manage Hyper-V targets (Ctrl+N)"
                        Click="ConnectMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Icon.Link}" Width="20" Height="20"/>
                        <TextBlock Text="Connect..." Style="{StaticResource HeaderButtonText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SettingsHeaderButton"
                        Style="{StaticResource IconOnlyButton}"
                        Height="48"
                        Width="48"
                        ToolTip="Preferences"
                        Click="SettingsHeaderButton_Click">
                    <controls:Icon Data="{StaticResource Icon.Settings}" Width="22" Height="22"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- SUMMARY CARDS -->
        <UniformGrid Grid.Row="2" Columns="7" Margin="22,0,22,12">
            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#E5EEFC">
                        <controls:Icon Data="{StaticResource Icon.ServerStack}" Width="24" Height="24" Foreground="#2F6FE0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalVmText" Text="0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Total VMs" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#E3F6EA">
                        <controls:Icon Data="{StaticResource Icon.PlayCircle}" Width="24" Height="24" Foreground="#1FA453"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RunningVmText" Text="0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Running" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#FDE8E8">
                        <controls:Icon Data="{StaticResource Icon.Stop}" Width="24" Height="24" Foreground="#E0453F"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PoweredOffVmText" Text="0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Powered Off" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#ECE8FB">
                        <controls:Icon Data="{StaticResource Icon.Cpu}" Width="24" Height="24" Foreground="#6A4FE0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalCpuText" Text="0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Total CPUs" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#F2E6FB">
                        <controls:Icon Data="{StaticResource Icon.Database}" Width="24" Height="24" Foreground="#9B4FD0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AssignedMemoryText" Text="0 GB" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Assigned Memory" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#FDEEE0">
                        <controls:Icon Data="{StaticResource Icon.File}" Width="24" Height="24" Foreground="#F0883A"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CheckpointText" Text="0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Checkpoints" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="#E1F5EA">
                        <controls:Icon Data="{StaticResource Icon.Nodes}" Width="24" Height="24" Foreground="#22A06B"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NodesQueriedText" Text="0/0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Nodes Queried" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- SEARCH + FILTERS -->
        <Grid Grid.Row="3" Margin="28,4,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <controls:Icon Data="{StaticResource Icon.Clock}" Width="18" Height="18" Foreground="#5A6B85"/>
                <TextBlock x:Name="LastUpdatedText"
                           Text="Last updated: Never | LOCAL"
                           Foreground="#3A4A63"
                           FontSize="12"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="0,0,24,0">
                <TextBox x:Name="VmSearchTextBox"
                         Height="42"
                         Padding="42,0,20,0"
                         VerticalContentAlignment="Center"
                         TextChanged="VmSearchTextBox_TextChanged"
                         KeyDown="VmSearchTextBox_KeyDown"/>

                <controls:Icon Data="{StaticResource Icon.Search}"
                               Width="18" Height="18"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="#7A889E"/>

                <TextBlock x:Name="VmSearchPlaceholder"
                           Text="Search VMs, hosts, or IP addresses..."
                           Margin="42,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#8A97AB"
                           IsHitTestVisible="False"/>

                <Button x:Name="ClearSearchButton"
                        Style="{StaticResource GhostButton}"
                        Width="26"
                        Height="26"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="Clear search (Esc)"
                        Click="ClearSearchButton_Click">
                    <controls:Icon Data="{StaticResource Icon.Close}" Width="14" Height="14"/>
                </Button>
            </Grid>

            <TextBlock Grid.Column="2" Text="Cluster:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <ComboBox x:Name="ClusterFilterComboBox"
                      Grid.Column="3"
                      Height="42"
                      Margin="0,0,24,0"
                      SelectionChanged="ClusterFilterComboBox_SelectionChanged"/>

            <TextBlock Grid.Column="4" Text="Host:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <ComboBox x:Name="HostFilterComboBox"
                      Grid.Column="5"
                      Height="42"
                      Margin="0,0,24,0"
                      SelectionChanged="HostFilterComboBox_SelectionChanged"/>

            <TextBlock Grid.Column="6" Text="State:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <ComboBox x:Name="StateFilterComboBox"
                      Grid.Column="7"
                      Height="42"
                      SelectionChanged="StateFilterComboBox_SelectionChanged"/>
        </Grid>

        <!-- TABS -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="28,0,28,14" Padding="6,0,6,0">
        <TabControl x:Name="InventoryTabControl"
            Padding="16,14,16,14">

            <TabItem Header="vSummary">
                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="White"
                        ClipToBounds="True">
                    <DataGrid x:Name="SummaryDataGrid"
                              BorderThickness="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM Name" Binding="{Binding Name}" SortMemberPath="Name" Width="170"/>
                            <DataGridTextColumn Header="VM ID" Binding="{Binding VMId}" SortMemberPath="VMId" Width="270"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding HostName}" SortMemberPath="HostName" Width="130"/>
                            <DataGridTextColumn Header="Cluster" Binding="{Binding ClusterName}" SortMemberPath="ClusterName" Width="130"/>

                            <DataGridTemplateColumn Header="State" SortMemberPath="State" ClipboardContentBinding="{Binding State}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF4DC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter Property="Background" Value="#E3F6EA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Off">
                                                            <Setter Property="Background" Value="#FDE8E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding State}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B26A00"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                                <Setter Property="Foreground" Value="#1FA453"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Off">
                                                                <Setter Property="Foreground" Value="#E0453F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="IPv4 Address" Binding="{Binding IPv4Addresses}" SortMemberPath="IPv4Addresses" Width="150"/>

                            <DataGridTemplateColumn Header="CPU Usage" SortMemberPath="CpuUsage" ClipboardContentBinding="{Binding CpuUsageText}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuUsageText}"/>
                                            <ProgressBar Height="5" Margin="0,3,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding CpuUsage, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Processor Count" Binding="{Binding ProcessorCount}" SortMemberPath="ProcessorCount" Width="115"/>
                            <DataGridTextColumn Header="Memory Status" Binding="{Binding MemoryStatus}" SortMemberPath="MemoryStatus" Width="115"/>

                            <DataGridTemplateColumn Header="Memory Usage" SortMemberPath="MemoryUsagePercent" ClipboardContentBinding="{Binding MemoryUsageText}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MemoryUsageText}"/>
                                            <ProgressBar Height="5" Margin="0,3,0,0" Minimum="0" Maximum="100"
                                                         Foreground="{StaticResource GreenBrush}"
                                                         Value="{Binding MemoryUsagePercent, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Uptime" Binding="{Binding UptimeText}" SortMemberPath="Uptime" Width="100"/>
                            <DataGridTextColumn Header="Boot Time" Binding="{Binding BootTimeText}" SortMemberPath="BootTime" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="vInfo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="White"
                            ClipToBounds="True">
                        <Grid>
                    <DataGrid x:Name="VmDataGrid"
                      BorderThickness="0"
                      Sorting="VmDataGrid_Sorting"
                      
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM Name"
                                        Binding="{Binding Name}"
                                        SortMemberPath="Name"
                                        Width="220"/>

                            <DataGridTextColumn Header="VM ID"
                                        Binding="{Binding VMId}"
                                        SortMemberPath="VMId"
                                        Width="280"/>

                            <DataGridTextColumn Header="Host"
                                        Binding="{Binding HostName}"
                                        SortMemberPath="HostName"
                                        Width="180"/>

                            <DataGridTextColumn Header="Cluster"
                                        Binding="{Binding ClusterName}"
                                        SortMemberPath="ClusterName"
                                        Width="180"/>

                            <DataGridTextColumn Header="State"
                                        Binding="{Binding State}"
                                        SortMemberPath="State"
                                        Width="100"/>

                            <DataGridTextColumn Header="CPU Usage"
                                        Binding="{Binding CPUUsage}"
                                        SortMemberPath="CPUUsage"
                                        Width="100"/>

                            <DataGridTextColumn Header="Processor Count"
                                        Binding="{Binding ProcessorCount}"
                                        SortMemberPath="ProcessorCount"
                                        Width="120"/>

                            <DataGridTextColumn Header="Memory Status"
                                        Binding="{Binding MemoryStatus}"
                                        SortMemberPath="MemoryStatus"
                                        Width="130"/>

                            <DataGridTextColumn Header="Dynamic Memory"
                                        Binding="{Binding DynamicMemoryEnabled}"
                                        SortMemberPath="DynamicMemoryEnabled"
                                        Width="130"/>

                            <DataGridTextColumn
                                Header="Memory Assigned"
                                Binding="{Binding MemoryAssigned, Converter={StaticResource ByteSizeConverter}}"
                                SortMemberPath="MemoryAssigned"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="Memory Demand"
                                Binding="{Binding MemoryDemand, Converter={StaticResource ByteSizeConverter}}"
                                SortMemberPath="MemoryDemand"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="Memory Startup"
                                Binding="{Binding MemoryStartup, Converter={StaticResource ByteSizeConverter}}"
                                SortMemberPath="MemoryStartup"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="Memory Minimum"
                                Binding="{Binding MemoryMinimum, Converter={StaticResource ByteSizeConverter}}"
                                SortMemberPath="MemoryMinimum"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="Memory Maximum"
                                Binding="{Binding MemoryMaximum, Converter={StaticResource ByteSizeConverter}}"
                                SortMemberPath="MemoryMaximum"
                                Width="140"/>

                            <DataGridTextColumn Header="Generation"
                                        Binding="{Binding Generation}"
                                        SortMemberPath="Generation"
                                        Width="100"/>

                            <DataGridTextColumn Header="Version"
                                        Binding="{Binding Version}"
                                        SortMemberPath="Version"
                                        Width="100"/>

                            <DataGridTextColumn Header="VM Type"
                                        Binding="{Binding VirtualMachineType}"
                                        SortMemberPath="VirtualMachineType"
                                        Width="180"/>

                            <DataGridTextColumn Header="VM SubType"
                                        Binding="{Binding VirtualMachineSubType}"
                                        SortMemberPath="VirtualMachineSubType"
                                        Width="140"/>

                            <DataGridTextColumn Header="Checkpoint Type"
                                        Binding="{Binding CheckpointType}"
                                        SortMemberPath="CheckpointType"
                                        Width="140"/>

                            <DataGridTextColumn Header="Replication Health"
                                        Binding="{Binding ReplicationHealth}"
                                        SortMemberPath="ReplicationHealth"
                                        Width="150"/>

                            <DataGridTextColumn Header="Replication Mode"
                                        Binding="{Binding ReplicationMode}"
                                        SortMemberPath="ReplicationMode"
                                        Width="140"/>

                            <DataGridTextColumn Header="Replication State"
                                        Binding="{Binding ReplicationState}"
                                        SortMemberPath="ReplicationState"
                                        Width="140"/>

                            <DataGridTextColumn Header="Heartbeat"
                                        Binding="{Binding Heartbeat}"
                                        SortMemberPath="Heartbeat"
                                        Width="180"/>

                            <DataGridTextColumn Header="Integration Services"
                                        Binding="{Binding IntegrationServicesState}"
                                        SortMemberPath="IntegrationServicesState"
                                        Width="170"/>

                            <DataGridTextColumn Header="Integration Version"
                                        Binding="{Binding IntegrationServicesVersion}"
                                        SortMemberPath="IntegrationServicesVersion"
                                        Width="150"/>

                            <DataGridTextColumn Header="Uptime"
                                        Binding="{Binding Uptime}"
                                        SortMemberPath="Uptime"
                                        Width="150"/>

                            <DataGridTextColumn Header="Boot Time"
                                        Binding="{Binding BootTime}"
                                        SortMemberPath="BootTime"
                                        Width="160"/>

                            <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        SortMemberPath="Status"
                                        Width="180"/>

                            <DataGridTextColumn Header="Primary Operational Status"
                                        Binding="{Binding PrimaryOperationalStatus}"
                                        SortMemberPath="PrimaryOperationalStatus"
                                        Width="200"/>

                            <DataGridTextColumn Header="Primary Status Description"
                                        Binding="{Binding PrimaryStatusDescription}"
                                        SortMemberPath="PrimaryStatusDescription"
                                        Width="220"/>

                            <DataGridTextColumn Header="NUMA Aligned"
                                        Binding="{Binding NumaAligned}"
                                        SortMemberPath="NumaAligned"
                                        Width="120"/>

                            <DataGridTextColumn Header="NUMA Nodes"
                                        Binding="{Binding NumaNodesCount}"
                                        SortMemberPath="NumaNodesCount"
                                        Width="110"/>

                            <DataGridTextColumn Header="NUMA Sockets"
                                        Binding="{Binding NumaSocketCount}"
                                        SortMemberPath="NumaSocketCount"
                                        Width="120"/>

                            <DataGridTextColumn Header="Resource Metering"
                                        Binding="{Binding ResourceMeteringEnabled}"
                                        SortMemberPath="ResourceMeteringEnabled"
                                        Width="140"/>

                            <DataGridTextColumn Header="Enhanced Session Transport"
                                        Binding="{Binding EnhancedSessionTransportType}"
                                        SortMemberPath="EnhancedSessionTransportType"
                                        Width="200"/>

                            <DataGridTextColumn Header="Guest State Isolation"
                                        Binding="{Binding GuestStateIsolationType}"
                                        SortMemberPath="GuestStateIsolationType"
                                        Width="170"/>

                            <DataGridTextColumn Header="Automatic Start"
                                        Binding="{Binding AutomaticStartAction}"
                                        SortMemberPath="AutomaticStartAction"
                                        Width="150"/>

                            <DataGridTextColumn Header="Start Delay"
                                        Binding="{Binding AutomaticStartDelay}"
                                        SortMemberPath="AutomaticStartDelay"
                                        Width="100"/>

                            <DataGridTextColumn Header="Automatic Stop"
                                        Binding="{Binding AutomaticStopAction}"
                                        SortMemberPath="AutomaticStopAction"
                                        Width="150"/>

                            <DataGridTextColumn Header="Automatic Checkpoints"
                                        Binding="{Binding AutomaticCheckpointsEnabled}"
                                        SortMemberPath="AutomaticCheckpointsEnabled"
                                        Width="160"/>

                            <DataGridTextColumn Header="Critical Error Action"
                                        Binding="{Binding AutomaticCriticalErrorAction}"
                                        SortMemberPath="AutomaticCriticalErrorAction"
                                        Width="180"/>

                            <DataGridTextColumn Header="Critical Error Timeout"
                                        Binding="{Binding AutomaticCriticalErrorActionTimeout}"
                                        SortMemberPath="AutomaticCriticalErrorActionTimeout"
                                        Width="160"/>

                            <DataGridTextColumn Header="Smart Paging In Use"
                                        Binding="{Binding SmartPagingFileInUse}"
                                        SortMemberPath="SmartPagingFileInUse"
