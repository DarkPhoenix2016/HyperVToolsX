            <TabItem Header="vNetwork">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="NetworkDataGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="28">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM Name"
                                        Binding="{Binding VmName}"
                                        SortMemberPath="VmName"
                                        Width="220"/>

                            <DataGridTextColumn Header="Host"
                                        Binding="{Binding HostName}"
                                        SortMemberPath="HostName"
                                        Width="180"/>

                            <DataGridTextColumn Header="Adapter"
                                        Binding="{Binding Name}"
                                        SortMemberPath="Name"
                                        Width="220"/>

                            <DataGridTextColumn Header="Switch"
                                        Binding="{Binding SwitchName}"
                                        SortMemberPath="SwitchName"
