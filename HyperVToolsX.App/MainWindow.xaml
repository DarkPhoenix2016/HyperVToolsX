<Window x:Class="HyperVToolsX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HyperVToolsX.App.Converters"
        Title="HyperVToolsX"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
    </Window.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Connect..." Click="ConnectMenuItem_Click"/>
                <MenuItem Header="Disconnect Selected" Click="DisconnectSelectedMenuItem_Click"/>
                <MenuItem Header="Disconnect All" Click="DisconnectAllMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Export to Excel"/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="_Preferences">
                <MenuItem Header="Data Size Unit">
                    <Separator/>

                    <MenuItem
            x:Name="BytesUnitMenuItem"
            Header="Bytes"
            IsCheckable="True"
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="KbUnitMenuItem"
            Header="KB"
            IsCheckable="True"
            
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="MbUnitMenuItem"
            Header="MB"
            IsCheckable="True"
            
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="GbUnitMenuItem"
            Header="GB"
            IsCheckable="True"
            
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="TbUnitMenuItem"
            Header="TB"
            IsCheckable="True"
            
            Click="SizeUnitMenuItem_Click"/>

                    <MenuItem
            x:Name="PbUnitMenuItem"
            Header="PB"
            IsCheckable="True"
            
            Click="SizeUnitMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Refresh"/>
            </MenuItem>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help">
                <MenuItem Header="About HyperVToolsX"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="#0067B8"
                Padding="18,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HyperVToolsX"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <Border Background="#FFD400"
                            CornerRadius="3"
                            Margin="10,3,0,0"
                            Padding="6,2"
                            VerticalAlignment="Top">
                        <TextBlock Text="BETA"
                                   Foreground="#333333"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Hyper-V Inventory &amp; Documentation Tool"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="7"
                     Margin="8,8,8,4">
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="TotalVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Total VMs"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="RunningVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Running"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="PoweredOffVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Powered Off"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="TotalCpuText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Total CPUs"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0 GB"
                               x:Name="AssignedMemoryText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Assigned Memory"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="CheckpointText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Checkpoints"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0/0"
                               x:Name="NodesQueriedText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Nodes Queried"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="3"
                   x:Name="LastUpdatedText"
                   Text="Last updated: Never | LOCAL"
                   Margin="12,2,12,6"
                   Foreground="#555555"
                   FontSize="12"/>

        <Grid Grid.Row="4"
              Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,8,0">
                <TextBox x:Name="VmSearchTextBox"
                         Height="32"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="VmSearchTextBox_TextChanged"/>
                <TextBlock x:Name="VmSearchPlaceholder"
                           Text="Search VMs, hosts, or IP addresses..."
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Column="1"
                  Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Cluster:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="ClusterFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ClusterFilterComboBox_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="2"
                  Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Host:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="HostFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="HostFilterComboBox_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="3"
                  Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="State:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="StateFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="StateFilterComboBox_SelectionChanged"/>
            </Grid>
        </Grid>

        <TabControl Grid.Row="5"
            Margin="8,0,8,4">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="vInfo">
