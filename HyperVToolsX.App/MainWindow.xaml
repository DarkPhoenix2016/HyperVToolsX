                    Binding="{Binding TotalVisibleMemorySizeKb}" />

                            <DataGridTextColumn
                    Width="180"
                    Header="Free Physical Memory (KB)"
                    Binding="{Binding FreePhysicalMemoryKb}" />


                            <!-- Hyper-V Storage -->
                            <DataGridTextColumn
                    Width="320"
