<Window x:Class="HyperVToolsX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperVToolsX"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Connect..." Click="ConnectMenuItem_Click"/>
                <MenuItem Header="Disconnect Selected" Click="DisconnectSelectedMenuItem_Click"/>
                <MenuItem Header="Disconnect All" Click="DisconnectAllMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Export to Excel"/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Refresh"/>
            </MenuItem>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help">
                <MenuItem Header="About HyperVToolsX"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="#0067B8"
                Padding="18,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HyperVToolsX"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <Border Background="#FFD400"
                            CornerRadius="3"
                            Margin="10,3,0,0"
                            Padding="6,2"
                            VerticalAlignment="Top">
                        <TextBlock Text="BETA"
                                   Foreground="#333333"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Hyper-V Inventory &amp; Documentation Tool"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="7"
                     Margin="8,8,8,4">
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="TotalVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Total VMs"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="RunningVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Running"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="PoweredOffVmText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Powered Off"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="TotalCpuText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Total CPUs"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0 GB"
                               x:Name="AssignedMemoryText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Assigned Memory"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0"
                               x:Name="CheckpointText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Checkpoints"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="0/0"
                               x:Name="NodesQueriedText"
                               Style="{StaticResource SummaryNumberStyle}"/>
                    <TextBlock Text="Nodes Queried"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="3"
                   x:Name="LastUpdatedText"
                   Text="Last updated: Never | LOCAL"
                   Margin="12,2,12,6"
                   Foreground="#555555"
                   FontSize="12"/>

        <Grid Grid.Row="4"
              Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,8,0">
                <TextBox x:Name="VmSearchTextBox"
                         Height="32"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="VmSearchTextBox_TextChanged"/>
                <TextBlock x:Name="VmSearchPlaceholder"
                           Text="Search VMs, hosts, or IP addresses..."
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Column="1"
                  Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Cluster:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="ClusterFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ClusterFilterComboBox_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="2"
                  Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Host:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="HostFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="HostFilterComboBox_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="3"
                  Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="State:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="StateFilterComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          SelectionChanged="StateFilterComboBox_SelectionChanged"/>
            </Grid>
        </Grid>

        <TabControl Grid.Row="5"
            Margin="8,0,8,4">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="vInfo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="VmDataGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="28">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM Name"
                                        Binding="{Binding Name}"
                                        SortMemberPath="Name"
                                        Width="220"/>

                            <DataGridTextColumn Header="VM ID"
                                        Binding="{Binding VMId}"
                                        SortMemberPath="VMId"
                                        Width="280"/>

                            <DataGridTextColumn Header="Host"
                                        Binding="{Binding HostName}"
                                        SortMemberPath="HostName"
                                        Width="180"/>

                            <DataGridTextColumn Header="Cluster"
                                        Binding="{Binding ClusterName}"
                                        SortMemberPath="ClusterName"
                                        Width="180"/>

                            <DataGridTextColumn Header="State"
                                        Binding="{Binding State}"
                                        SortMemberPath="State"
                                        Width="100"/>

                            <DataGridTextColumn Header="CPU Usage"
                                        Binding="{Binding CPUUsage}"
                                        SortMemberPath="CPUUsage"
                                        Width="100"/>

                            <DataGridTextColumn Header="Processor Count"
                                        Binding="{Binding ProcessorCount}"
                                        SortMemberPath="ProcessorCount"
                                        Width="120"/>

                            <DataGridTextColumn Header="Memory Assigned"
                                        Binding="{Binding MemoryAssigned}"
                                        SortMemberPath="MemoryAssigned"
                                        Width="140"/>

                            <DataGridTextColumn Header="Memory Demand"
                                        Binding="{Binding MemoryDemand}"
                                        SortMemberPath="MemoryDemand"
                                        Width="140"/>

                            <DataGridTextColumn Header="Memory Status"
                                        Binding="{Binding MemoryStatus}"
                                        SortMemberPath="MemoryStatus"
                                        Width="130"/>

                            <DataGridTextColumn Header="Dynamic Memory"
                                        Binding="{Binding DynamicMemoryEnabled}"
                                        SortMemberPath="DynamicMemoryEnabled"
                                        Width="130"/>

                            <DataGridTextColumn Header="Memory Startup"
                                        Binding="{Binding MemoryStartup}"
                                        SortMemberPath="MemoryStartup"
                                        Width="140"/>

                            <DataGridTextColumn Header="Memory Minimum"
                                        Binding="{Binding MemoryMinimum}"
                                        SortMemberPath="MemoryMinimum"
                                        Width="140"/>

                            <DataGridTextColumn Header="Memory Maximum"
                                        Binding="{Binding MemoryMaximum}"
                                        SortMemberPath="MemoryMaximum"
                                        Width="140"/>

                            <DataGridTextColumn Header="Generation"
                                        Binding="{Binding Generation}"
                                        SortMemberPath="Generation"
                                        Width="100"/>

                            <DataGridTextColumn Header="Version"
                                        Binding="{Binding Version}"
                                        SortMemberPath="Version"
                                        Width="100"/>

                            <DataGridTextColumn Header="VM Type"
                                        Binding="{Binding VirtualMachineType}"
                                        SortMemberPath="VirtualMachineType"
                                        Width="180"/>

                            <DataGridTextColumn Header="VM SubType"
                                        Binding="{Binding VirtualMachineSubType}"
                                        SortMemberPath="VirtualMachineSubType"
                                        Width="140"/>

                            <DataGridTextColumn Header="Checkpoint Type"
                                        Binding="{Binding CheckpointType}"
                                        SortMemberPath="CheckpointType"
                                        Width="140"/>

                            <DataGridTextColumn Header="Replication Health"
                                        Binding="{Binding ReplicationHealth}"
                                        SortMemberPath="ReplicationHealth"
                                        Width="150"/>

                            <DataGridTextColumn Header="Replication Mode"
                                        Binding="{Binding ReplicationMode}"
                                        SortMemberPath="ReplicationMode"
                                        Width="140"/>

                            <DataGridTextColumn Header="Replication State"
                                        Binding="{Binding ReplicationState}"
                                        SortMemberPath="ReplicationState"
                                        Width="140"/>

                            <DataGridTextColumn Header="Heartbeat"
                                        Binding="{Binding Heartbeat}"
                                        SortMemberPath="Heartbeat"
                                        Width="180"/>

                            <DataGridTextColumn Header="Integration Services"
                                        Binding="{Binding IntegrationServicesState}"
                                        SortMemberPath="IntegrationServicesState"
                                        Width="170"/>

                            <DataGridTextColumn Header="Integration Version"
                                        Binding="{Binding IntegrationServicesVersion}"
                                        SortMemberPath="IntegrationServicesVersion"
                                        Width="150"/>

                            <DataGridTextColumn Header="Uptime"
                                        Binding="{Binding Uptime}"
                                        SortMemberPath="Uptime"
                                        Width="150"/>

                            <DataGridTextColumn Header="Boot Time"
                                        Binding="{Binding BootTime}"
                                        SortMemberPath="BootTime"
                                        Width="160"/>

                            <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        SortMemberPath="Status"
                                        Width="180"/>

                            <DataGridTextColumn Header="Primary Operational Status"
                                        Binding="{Binding PrimaryOperationalStatus}"
                                        SortMemberPath="PrimaryOperationalStatus"
                                        Width="200"/>

                            <DataGridTextColumn Header="Primary Status Description"
                                        Binding="{Binding PrimaryStatusDescription}"
                                        SortMemberPath="PrimaryStatusDescription"
                                        Width="220"/>

                            <DataGridTextColumn Header="NUMA Aligned"
                                        Binding="{Binding NumaAligned}"
                                        SortMemberPath="NumaAligned"
                                        Width="120"/>

                            <DataGridTextColumn Header="NUMA Nodes"
                                        Binding="{Binding NumaNodesCount}"
                                        SortMemberPath="NumaNodesCount"
                                        Width="110"/>

                            <DataGridTextColumn Header="NUMA Sockets"
                                        Binding="{Binding NumaSocketCount}"
                                        SortMemberPath="NumaSocketCount"
                                        Width="120"/>

                            <DataGridTextColumn Header="Resource Metering"
                                        Binding="{Binding ResourceMeteringEnabled}"
                                        SortMemberPath="ResourceMeteringEnabled"
                                        Width="140"/>

                            <DataGridTextColumn Header="Enhanced Session Transport"
                                        Binding="{Binding EnhancedSessionTransportType}"
                                        SortMemberPath="EnhancedSessionTransportType"
                                        Width="200"/>

                            <DataGridTextColumn Header="Guest State Isolation"
                                        Binding="{Binding GuestStateIsolationType}"
                                        SortMemberPath="GuestStateIsolationType"
                                        Width="170"/>

                            <DataGridTextColumn Header="Automatic Start"
                                        Binding="{Binding AutomaticStartAction}"
                                        SortMemberPath="AutomaticStartAction"
                                        Width="150"/>

                            <DataGridTextColumn Header="Start Delay"
                                        Binding="{Binding AutomaticStartDelay}"
                                        SortMemberPath="AutomaticStartDelay"
                                        Width="100"/>

                            <DataGridTextColumn Header="Automatic Stop"
                                        Binding="{Binding AutomaticStopAction}"
                                        SortMemberPath="AutomaticStopAction"
                                        Width="150"/>

                            <DataGridTextColumn Header="Automatic Checkpoints"
                                        Binding="{Binding AutomaticCheckpointsEnabled}"
                                        SortMemberPath="AutomaticCheckpointsEnabled"
                                        Width="160"/>

                            <DataGridTextColumn Header="Critical Error Action"
                                        Binding="{Binding AutomaticCriticalErrorAction}"
                                        SortMemberPath="AutomaticCriticalErrorAction"
                                        Width="180"/>

                            <DataGridTextColumn Header="Critical Error Timeout"
                                        Binding="{Binding AutomaticCriticalErrorActionTimeout}"
                                        SortMemberPath="AutomaticCriticalErrorActionTimeout"
                                        Width="160"/>

                            <DataGridTextColumn Header="Smart Paging In Use"
                                        Binding="{Binding SmartPagingFileInUse}"
                                        SortMemberPath="SmartPagingFileInUse"
                                        Width="150"/>

                            <DataGridTextColumn Header="Configuration Location"
                                        Binding="{Binding ConfigurationLocation}"
                                        SortMemberPath="ConfigurationLocation"
                                        Width="300"/>

                            <DataGridTextColumn Header="Checkpoint Location"
                                        Binding="{Binding CheckpointFileLocation}"
                                        SortMemberPath="CheckpointFileLocation"
                                        Width="300"/>

                            <DataGridTextColumn Header="Snapshot Location"
                                        Binding="{Binding SnapshotFileLocation}"
                                        SortMemberPath="SnapshotFileLocation"
                                        Width="300"/>

                            <DataGridTextColumn Header="Guest State Path"
                                        Binding="{Binding GuestStatePath}"
                                        SortMemberPath="GuestStatePath"
                                        Width="300"/>

                            <DataGridTextColumn Header="Smart Paging Path"
                                        Binding="{Binding SmartPagingFilePath}"
                                        SortMemberPath="SmartPagingFilePath"
                                        Width="300"/>

                            <DataGridTextColumn Header="Notes"
                                        Binding="{Binding Notes}"
                                        SortMemberPath="Notes"
                                        Width="250"/>

                            <DataGridTextColumn Header="Clustered"
                                        Binding="{Binding IsClustered}"
                                        SortMemberPath="IsClustered"
                                        Width="100"/>

                            <DataGridTextColumn Header="Battery Passthrough"
                                        Binding="{Binding BatteryPassthroughEnabled}"
                                        SortMemberPath="BatteryPassthroughEnabled"
                                        Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="VmSummaryCountText"
                       Grid.Row="1"
                       Margin="4,6,4,0"
                       Foreground="#666666"
                       Text="Showing 0 of 0 VMs"/>
                </Grid>
            </TabItem>

            <TabItem Header="vCPU">
                <DataGrid x:Name="CpuDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  RowHeight="28">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="VM Name"
