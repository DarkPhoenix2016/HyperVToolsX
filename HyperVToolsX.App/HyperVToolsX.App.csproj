<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Application identity -->
    <AssemblyName>HyperVToolsX</AssemblyName>
    <RootNamespace>HyperVToolsX.App</RootNamespace>

    <!-- Version -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Publisher / Windows file information -->
    <Product>HyperVToolsX</Product>
    <Description>Hyper-V Inventory and Management Tool</Description>
    <Company>Charitha Piyumal</Company>
    <Authors>Charitha Piyumal</Authors>
    <Copyright>Copyright © 2026 Charitha Piyumal</Copyright>

    <!-- Distribution -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Single-file publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ReadyToRun precompiles the app for faster start-up; trimming stays off (WPF/reflection-heavy) -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Release distribution -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\logo.png" />
    <None Remove="Views\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperVToolsX.Core\HyperVToolsX.Core.csproj" />
    <ProjectReference Include="..\HyperVToolsX.Export\HyperVToolsX.Export.csproj" />
    <ProjectReference Include="..\HyperVToolsX.Infrastructure\HyperVToolsX.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Views\logo.png" />
  </ItemGroup>

</Project>