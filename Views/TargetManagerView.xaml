<UserControl x:Class="HyperVToolsX.App.Views.TargetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900"
             MinHeight="520">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">
            <TextBlock Text="Target Manager"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="Manage Hyper-V hosts, clusters, and connection settings."
                       Foreground="#666666"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    x:Name="TargetManagerTabControl">
            <TabItem Header="Hosts / Clusters">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="120"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Hosts / Clusters"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBox x:Name="TargetInputTextBox"
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Padding="6"
                                         FontFamily="Consolas"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="ImportButton"
                                    Content="Import TXT"
                                    Width="120"
                                    Height="32"
                                    Margin="0,0,0,6"
                                    Click="ImportButton_Click"/>

                            <Button x:Name="AddTargetsButton"
                                    Content="Add Targets"
                                    Width="120"
                                    Height="32"
                                    Margin="0,0,0,6"
                                    Click="AddTargetsButton_Click"/>

                            <Button x:Name="ClearButton"
                                    Content="Clear"
                                    Width="120"
                                    Height="32"
                                    Click="ClearButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F5F5F5"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TargetCountText"
                                               Text="0 targets"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Workers:"
                                               Margin="20,0,5,0"/>

                                    <TextBlock x:Name="WorkerCountText"
                                               Grid.Column="2"
                                               Text="1"
                                               FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="TargetDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserReorderColumns="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      RowHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Target"
                                                        Binding="{Binding Name}"
                                                        SortMemberPath="Name"
                                                        Width="2*"
                                                        MinWidth="180"/>

                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding Type}"
                                                        SortMemberPath="Type"
                                                        Width="120"
                                                        MinWidth="100"/>

                                    <DataGridTextColumn Header="DNS"
                                                        Binding="{Binding NameResolved}"
                                                        SortMemberPath="NameResolved"
                                                        Width="90"
                                                        MinWidth="70"/>

                                    <DataGridTextColumn Header="Ping"
                                                        Binding="{Binding PingSucceeded}"
                                                        SortMemberPath="PingSucceeded"
                                                        Width="90"
                                                        MinWidth="70"/>

                                    <DataGridTextColumn Header="Hyper-V"
                                                        Binding="{Binding HyperVConnectionSucceeded}"
                                                        SortMemberPath="HyperVConnectionSucceeded"
                                                        Width="100"
                                                        MinWidth="80"/>

                                    <DataGridTextColumn Header="Result"
                                                        Binding="{Binding Result}"
                                                        SortMemberPath="Result"
                                                        Width="2*"
                                                        MinWidth="160"/>

                                    <DataGridTextColumn Header="Error"
                                                        Binding="{Binding ErrorMessage}"
                                                        SortMemberPath="ErrorMessage"
                                                        Width="3*"
                                                        MinWidth="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2"
                        Margin="0,15,0,0">
                            <StackPanel Orientation="Horizontal" 
                                        DockPanel.Dock="Right">
                            <Button x:Name="ValidateButton"
                                Content="Validate Targets"
                                Width="140"
                                Height="35"
                                Margin="0,0,8,0"
                                Click="ValidateButton_Click"/>  

                            <Button x:Name="CollectButton"
                                Content="Start Collection"
                                Width="140"
                                Height="35"
                                IsEnabled="False"
                                Click="CollectButton_Click"/>   
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                            VerticalAlignment="Center"
                            Foreground="#666666"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Connection Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,12,0,0">
                    <Grid MaxWidth="700"
                          HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Authentication"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="UseCurrentWindowsCredentialsCheckBox"
                                  Grid.Row="1"
                                  Content="Use current Windows credentials"
                                  IsChecked="True"
                                  Margin="0,0,0,15"
                                  Checked="UseCurrentWindowsCredentialsCheckBox_Changed"
                                  Unchecked="UseCurrentWindowsCredentialsCheckBox_Changed"/>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Username:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="UsernameTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="28"
                                     Margin="0,0,0,8"
                                     IsEnabled="False"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Password:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <PasswordBox x:Name="PasswordBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="28"
                                         Margin="0,0,0,8"
                                         IsEnabled="False"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Authentication:"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="AuthenticationComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Height="28"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Default"/>
                                <ComboBoxItem Content="Negotiate"/>
                                <ComboBoxItem Content="Kerberos"/>
                                <ComboBoxItem Content="Basic"/>
                                <ComboBoxItem Content="CredSSP"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="Connection"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5,0,12"/>

                        <Grid Grid.Row="4"
                              Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="UseSslCheckBox"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Content="Use SSL/TLS (HTTPS - port 5986)"
                                      Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Port (0 = auto):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="PortTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Text="0"
                                     Height="28"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Timeout (seconds):"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="TimeoutTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Text="30"
                                     Height="28"/>
                        </Grid>

                        <TextBlock Grid.Row="5"
                                   Text="SSL Options (for self-signed certificates)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5,0,12"/>

                        <StackPanel Grid.Row="5"
                                    Margin="0,35,0,0">
                            <CheckBox x:Name="SkipCaCertificateCheckBox"
                                      Content="Skip CA certificate check"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="SkipCnHostnameCheckBox"
                                      Content="Skip CN (hostname) check"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>